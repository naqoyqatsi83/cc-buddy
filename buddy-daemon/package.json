{
  "name": "buddy-daemon",
  "version": "0.1.0",
  "description": "PC-side daemon that wraps the claude CLI in a PTY and pairs it with the CC Buddy Android app",
  "type": "module",
  "bin": {
    "buddy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "keytar": "^7.9.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
